{
  "name": "nautavo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:integration": "RUN_OSRM=1 vitest run tests/integration.test.ts",
    "test:tracks": "TRACKS=1 vitest run tests/local-tracks.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "eslint": "^10.0.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  }
}
