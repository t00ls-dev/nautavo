# Cloudflare Workers static assets (AGENTS.md, Hosting and publication).
# sw.js, the manifest and other fixed-URL files keep Cloudflare's default,
# revalidated on every request (max-age=0, must-revalidate).
# Every file in /assets/ is named by a hash of its contents, so it never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages keep that default and add no-transform, so Cloudflare never rewrites
# their HTML: no Web Analytics beacon, email obfuscation or other injection,
# whatever the dashboard settings. One rule per page in the sitemap.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/help
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/changelog
  Cache-Control: public, max-age=0, must-revalidate, no-transform
